From: ciscobugger <xizko55@gmail.com>
Subject: [DEBUG] phy: qcom-mipi-csi2-3ph-dphy: CSIPHY interrupt and status diagnostics

NOT A FIX. Diagnostics used while bringing up the camera: unmasks the
CSIPHY interrupts the driver normally masks, logs the first 20 IRQ
status snapshots and the lane/settle configuration, and re-masks after
500 interrupts. It spams dmesg on every stream start.

The kernel this port was verified on carried this patch. The camera is
not believed to depend on it; the first build without it should confirm
that (see README, "What is verified").

---
diff --git a/drivers/phy/qualcomm/phy-qcom-mipi-csi2-3ph-dphy.c b/drivers/phy/qualcomm/phy-qcom-mipi-csi2-3ph-dphy.c
index 1a99efee8..3a0ad157d 100644
--- a/drivers/phy/qualcomm/phy-qcom-mipi-csi2-3ph-dphy.c
+++ b/drivers/phy/qualcomm/phy-qcom-mipi-csi2-3ph-dphy.c
@@ -8,6 +8,7 @@
  * Copyright (C) 2016-2025 Linaro Ltd.
  */
 #define DEBUG
+#include <linux/atomic.h>
 #include <linux/delay.h>
 #include <linux/interrupt.h>
 #include <linux/io.h>
@@ -216,11 +217,30 @@ static void phy_qcom_mipi_csi2_reset(struct mipi_csi2phy_device *csi2phy)
 		       CSIPHY_3PH_CMN_CSI_COMMON_CTRLn(regs->offset, 0));
 }
 
+static atomic_t dbg_irq_count = ATOMIC_INIT(0);
+
 static irqreturn_t phy_qcom_mipi_csi2_isr(int irq, void *dev)
 {
 	const struct mipi_csi2phy_device *csi2phy = dev;
 	const struct mipi_csi2phy_device_regs *regs = csi2phy_dev_to_regs(csi2phy);
 	int i;
+	int n = atomic_inc_return(&dbg_irq_count);
+
+	if (n <= 20) {
+		u32 s[11];
+
+		for (i = 0; i < 11; i++)
+			s[i] = readl_relaxed(csi2phy->base +
+				CSIPHY_3PH_CMN_CSI_COMMON_STATUSn(regs->offset, i));
+		pr_info("CSIPHYDBG irq#%d status %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x\n",
+			n, s[0], s[1], s[2], s[3], s[4], s[5], s[6], s[7], s[8], s[9], s[10]);
+	}
+	if (n == 500) {
+		pr_info("CSIPHYDBG irq storm - remasking\n");
+		for (i = 11; i < 22; i++)
+			writel_relaxed(0, csi2phy->base +
+				CSIPHY_3PH_CMN_CSI_COMMON_CTRLn(regs->offset, i));
+	}
 
 	for (i = 0; i < 11; i++) {
 		int c = i + 22;
@@ -382,6 +402,7 @@ static int phy_qcom_mipi_csi2_lanes_enable(struct mipi_csi2phy_device *csi2phy,
 	struct mipi_csi2phy_lanes_cfg *lane_cfg = &cfg->lane_cfg;
 	u8 settle_cnt;
 	u8 val;
+	u8 dbg_lane_mask = 0;
 	int i;
 
 	settle_cnt = phy_qcom_mipi_csi2_settle_cnt_calc(cfg->link_freq, csi2phy->timer_clk_rate);
@@ -389,6 +410,7 @@ static int phy_qcom_mipi_csi2_lanes_enable(struct mipi_csi2phy_device *csi2phy,
 	val = CSIPHY_3PH_CMN_CSI_COMMON_CTRL5_CLK_ENABLE;
 	for (i = 0; i < cfg->num_data_lanes; i++)
 		val |= BIT(lane_cfg->data[i].pos * 2);
+	dbg_lane_mask = val;
 
 	writel_relaxed(val, csi2phy->base +
 		       CSIPHY_3PH_CMN_CSI_COMMON_CTRLn(regs->offset, 5));
@@ -410,12 +432,29 @@ static int phy_qcom_mipi_csi2_lanes_enable(struct mipi_csi2phy_device *csi2phy,
 	else
 		phy_qcom_mipi_csi2_gen1_config_lanes(csi2phy, cfg, settle_cnt);
 
-	/* IRQ_MASK registers - disable all interrupts */
+	/* CSIPHYDBG: ENABLE the interrupts this driver normally masks off */
 	for (i = 11; i < 22; i++) {
-		writel_relaxed(0, csi2phy->base +
+		writel_relaxed(0xff, csi2phy->base +
 			       CSIPHY_3PH_CMN_CSI_COMMON_CTRLn(regs->offset, i));
 	}
 
+	atomic_set(&dbg_irq_count, 0);
+	pr_info("CSIPHYDBG enable: link_freq=%lld timer_clk=%u settle=%u lanes=%u mask=0x%02x gen2=%d\n",
+		cfg->link_freq, csi2phy->timer_clk_rate, settle_cnt,
+		cfg->num_data_lanes, dbg_lane_mask, phy_qcom_mipi_csi2_is_gen2(csi2phy));
+	pr_info("CSIPHYDBG hw_version=0x%08x CTRL5_readback=0x%02x\n",
+		csi2phy->hw_version,
+		readl_relaxed(csi2phy->base +
+			CSIPHY_3PH_CMN_CSI_COMMON_CTRLn(regs->offset, 5)));
+	{
+		int k;
+
+		for (k = 0; k < 11; k++)
+			pr_info("CSIPHYDBG post-enable STATUS%d = 0x%02x\n", k,
+				readl_relaxed(csi2phy->base +
+					CSIPHY_3PH_CMN_CSI_COMMON_STATUSn(regs->offset, k)));
+	}
+
 	return 0;
 }
 
